# PostgreSQL connection (local Docker Postgres by default, see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slupia"

# Auth.js
NEXTAUTH_SECRET="generate-a-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin panel login (single owner account, no DB table for MVP)
ADMIN_LOGIN="admin"
ADMIN_PASSWORD_HASH="bcrypt-hash-of-the-admin-password"
