# PostgreSQL connection (local Docker Postgres by default, see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slupia"

# Auth.js
NEXTAUTH_SECRET="generate-a-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin panel login (single owner account, no DB table for MVP)
# IMPORTANT: Next.js expands "$name" in .env values, which corrupts bcrypt
# hashes (they're full of "$"). Escape every "$" as "\$" here, e.g.
# "\$2b\$10\$..." — see README for how to generate this value.
ADMIN_LOGIN="admin"
ADMIN_PASSWORD_HASH="bcrypt-hash-of-the-admin-password-with-escaped-dollar-signs"
